{
  "name": "gt-pdf",
  "version": "0.0.0",
  "private": true,
  "description": "Editor PDF con quote: web app statica, i file restano sul dispositivo",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test-pdfs": "node scripts/make-test-pdfs.mjs",
    "icons": "node scripts/make-icons.mjs",
    "helvetica-widths": "node scripts/make-helvetica-widths.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
